{
  "name": "kimhardaneapp",
  "productName": "KimHardaNeApp",
  "version": "1.6.0",
  "private": true,
  "description": "Quiz questions: search, edit and play them, from the data sources you install",
  "author": "KimHardaNeApp",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "ui": "vite build",
    "embed": "node ai.js",
    "test": "node --test",
    "bench": "node bench.js run",
    "dist": "vite build && electron-builder --config electron-builder.config.js --win --publish never",
    "dist:mac": "vite build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-kimhardane} electron-builder --config electron-builder.config.js --mac --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "electron-updater": "^6.8.9",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
